{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --ignore-scripts",
  "builds": [
    {
      "src": "artifacts/taxi-fleet/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/simulate/(.*)",
      "dest": "/api/simulate/route"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
